# Local Docker defaults. Replace both occurrences of change-me with the same
# development-only password before running Docker Compose.
POSTGRES_USER=wallpanels
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wallpanels_platform
DATABASE_URL=postgresql+asyncpg://wallpanels:change-me@127.0.0.1:55433/wallpanels_platform
SECRET_KEY=change-this-local-jwt-secret
OPENAI_API_KEY=
# Relative paths are resolved against the backend cwd. Prefer an absolute path.
STORAGE_PATH=../../.local/storage
# Local Pre-Estimate appearance only; v1 remains available for rollback.
PRE_ESTIMATE_DESIGN=v2
ALLOWED_ORIGINS=http://localhost:5190,http://127.0.0.1:5190
BACKEND_PORT=8010
FRONTEND_PORT=5190
MAX_UPLOAD_SIZE_MB=20
# Optional pre-built SPA (absolute path):
FRONTEND_DIST=
# Start the bundled Docker database when no local listener exists:
LOCAL_DATABASE_MODE=docker
# For an existing Postgres.app / local cluster instead of Docker:
LOCAL_PG_BIN=
LOCAL_PG_DATA=
# Remote development databases require explicit opt-in; never use a production URL here.
ALLOW_REMOTE_DATABASE=false
ALLOW_SELF_REGISTRATION=false
AUTO_MIGRATE=false
ENABLE_PERMANENT_DELETE=false

# Optional credentials used only by explicit localhost QA scripts.
LOCAL_QA_EMAIL=
LOCAL_QA_PASSWORD=

# Optional: immutable account UUID allowed to use the Agentation toolbar.
# Empty disables it for everybody; never use a display name or a shared role.
AGENTATION_USER_ID=
# Approved JPEG export optimization for every account: 2560px / quality 95.
# Uploaded originals and corporate pages stay unchanged. Set false to roll back.
PDF_PHOTO_OPTIMIZATION_ENABLED=true

# Immutable UUID of the account that assigns employee page access.
# When unset, reuses AGENTATION_USER_ID (existing owner account).
ACCESS_MANAGER_USER_ID=

# Optional HR assistance via Groq; server-only, never VITE_ variables
GROQ_API_KEY=
HR_AI_MODEL=openai/gpt-oss-120b

# Optional Groq key for manual work-list extraction (server only, separate from HR).
MANUAL_IMPORT_GROQ_API_KEY=
MANUAL_IMPORT_AI_MODEL=openai/gpt-oss-120b
