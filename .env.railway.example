# Names/checklist only. Configure actual values in the new corporate Railway app.
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_PRIVATE_HOST:5432/REPLACE_DATABASE
SECRET_KEY=REPLACE_WITH_A_NEW_LONG_RANDOM_SECRET
STORAGE_PATH=/data
FRONTEND_DIST=/app/apps/frontend/dist
ALLOWED_ORIGINS=https://REPLACE_WITH_NEW_CORPORATE_APP_DOMAIN
ALLOW_SELF_REGISTRATION=false
AUTO_MIGRATE=false
ENABLE_PERMANENT_DELETE=false
REQUIRE_ESTIMATE_REVISION=true
MAX_UPLOAD_SIZE_MB=20
PRE_ESTIMATE_DESIGN=v2
OPENAI_API_KEY=
# Private backup bucket in the SAME approved corporate Railway project.
BACKUP_ENABLED=false
BACKUP_ENDPOINT=
BACKUP_BUCKET=
BACKUP_REGION=auto
BACKUP_ADDRESSING_STYLE=virtual-host
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=
